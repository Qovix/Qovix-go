func (s *DatabaseService) getPostgreSQLTableSchema(ctx context.Context, db *sql.DB, dbName, tableName string) (*models.TableSchema, error) {
	table := &models.TableSchema{
		Name:    tableName,
		Columns: []models.ColumnSchema{},
		Indexes: []models.IndexSchema{},
	}

	columnsQuery := `
		SELECT column_name, data_type, is_nullable, column_default, 
			   character_maximum_length
		FROM information_schema.columns 
		WHERE table_catalog = $1 AND table_schema = 'public' AND table_name = $2
		ORDER BY ordinal_position`

	rows, err := db.QueryContext(ctx, columnsQuery, dbName, tableName)
	if err != nil {
		return nil, err
	}
	defer rows.Close()

	for rows.Next() {
		var columnName, dataType, nullable string
		var defaultValue, maxLength sql.NullString

		err := rows.Scan(&columnName, &dataType, &nullable, &defaultValue, &maxLength)
		if err != nil {
			continue
		}

		column := models.ColumnSchema{
			Name:     columnName,
			Type:     dataType,
			Nullable: nullable == "YES",
		}

		if defaultValue.Valid {
			column.DefaultValue = defaultValue.String
			// Check if it's a sequence (auto increment)
			if strings.Contains(defaultValue.String, "nextval") {
				column.IsAutoIncr = true
			}
		}

		if maxLength.Valid {
			if length, err := strconv.Atoi(maxLength.String); err == nil {
				column.MaxLength = length
			}
		}

		table.Columns = append(table.Columns, column)
	}

	return table, nil
}

func (s *DatabaseService) testMongoDBConnection(ctx context.Context, req *models.DatabaseConnectionRequest) (*models.DatabaseConnectionResponse, error) {
	uri := fmt.Sprintf("mongodb://%s:%s@%s:%d/%s",
		req.Username, req.Password, req.Host, req.Port, req.Database)

	clientOptions := options.Client().ApplyURI(uri)

	ctx, cancel := context.WithTimeout(ctx, 10*time.Second)
	defer cancel()

	client, err := mongo.Connect(ctx, clientOptions)
	if err != nil {
		return &models.DatabaseConnectionResponse{
			Status:  models.StatusError,
			Message: fmt.Sprintf("Failed to connect to MongoDB: %v", err),
		}, nil
	}
	defer client.Disconnect(ctx)

	if err := client.Ping(ctx, nil); err != nil {
		return &models.DatabaseConnectionResponse{
			Status:  models.StatusError,
			Message: fmt.Sprintf("Failed to ping MongoDB server: %v", err),
		}, nil
	}

	return &models.DatabaseConnectionResponse{
		Status:   models.StatusConnected,
		Message:  "Successfully connected to MongoDB database",
		Database: req.Database,
		Schemas:  []string{req.Database},
	}, nil
}

